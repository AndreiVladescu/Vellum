# Vellum server — example configuration.
#
# The server is configured entirely by environment variables; this file is the
# list of them, with the default each one already has. Copy it and edit:
#
#     cp .env.example .env
#     set -a; . ./.env; set +a     # export everything in it
#     cargo run
#
# `.env` is gitignored (`.env.example` is the exception). Keep it that way —
# VELLUM_SMTP_PASS is a real credential, and chmod 600 .env is not paranoid.
#
# Every line below is commented out, so an untouched copy runs the same server
# as no configuration at all. Uncomment only what you mean to change.
#
# Docker Compose reads a *different* file: a `.env` in the repository root
# holding DOMAIN and ACME_EMAIL. See docker-compose.yml.

# ---- Where it listens and what it keeps ------------------------------------

# VELLUM_PORT=3000
# VELLUM_DB=./vellum.db
# VELLUM_DATA_DIR=./data

# The address people actually reach this server at. Public share links and the
# password-reset links in email are built from it, so localhost is right only
# while the server is genuinely local.
# VELLUM_PUBLIC_URL=http://localhost:3000

# Per-file upload cap, in MB.
# VELLUM_MAX_UPLOAD_MB=2048

# ---- Who can create the first account --------------------------------------

# The first account registered becomes the master. On a server that is reachable
# from outside your network, set this and the first registration must present it
# — otherwise whoever finds the port first owns the library. The console asks for
# it on the first-run form when it is set.
# VELLUM_BOOTSTRAP_TOKEN=

# ---- TLS -------------------------------------------------------------------
#
# For a LAN server with no domain. Behind Caddy, nginx or Cloudflare, leave all
# of this off and let them terminate TLS — see docs/DEPLOYMENT.md.

# 1 or true. Generates a self-signed pair on first start if none is configured.
# VELLUM_TLS=0
# VELLUM_TLS_CERT=<data dir>/cert.pem
# VELLUM_TLS_KEY=<data dir>/key.pem
# Extra names the generated certificate should be valid for, comma separated —
# the LAN IP or hostname a phone will use.
# VELLUM_TLS_SANS=192.168.1.20,vellum.local

# ---- Mail: password resets, invites, send-to-device -------------------------
#
# All optional. Without VELLUM_SMTP_HOST the server has no mailer, and every
# feature that needs one is hidden by the capability handshake rather than
# offered and then failing.
#
# The transport is STARTTLS on the submission port and checks the certificate
# against the compiled-in Mozilla roots, so a local catcher with a self-signed
# certificate will not work — test against a real relay.
#
# A typo here stops the server at startup rather than surfacing weeks later as a
# password reset that silently failed.

# VELLUM_SMTP_HOST=smtp.gmail.com
# VELLUM_SMTP_PORT=587
# VELLUM_SMTP_USER=you@gmail.com
# For Gmail this is an App Password (needs 2-step verification), never the
# account password.
# VELLUM_SMTP_PASS=
# Required once SMTP_HOST is set. Gmail rejects a From that isn't the
# authenticated account or one of its verified aliases.
# VELLUM_MAIL_FROM=Vellum <you@gmail.com>

# ---- Optional extras --------------------------------------------------------

# Index book contents so the console and app can search inside books. Costs disk
# roughly the size of the text, and can be dropped and rebuilt at any time.
# VELLUM_INDEX_TEXT=0

# Record who changed what. Worth turning on for a shared library, pointless for
# a single-user one.
# VELLUM_AUDIT=0

# Log filter: error, warn, info, debug — or per-module, e.g. vellum_server=debug.
# RUST_LOG=info
