<?xml version="1.0" encoding="utf-8"?>
<!--
  Vellum syncs to a self-hosted server. The supported transport is HTTPS — the
  server can generate a self-signed certificate and the app imports/pins it (see
  lib/server/cert_trust.dart), so no system-trusted CA is required.

  Cleartext HTTP is therefore blocked by default (Android's secure default),
  EXCEPT to the local loopback hosts used during development/testing:
    - localhost / 127.0.0.1   : on-device local server
    - 10.0.2.2 / 10.0.3.2     : the host machine as seen from the emulator
  A real LAN server reached by its 192.168.x.x address must use HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
    </domain-config>
</network-security-config>
