  "fixed_sql": [
    {
      "name": "books",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"books\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"subtitle\" TEXT NULL, \"description\" TEXT NULL, \"isbn\" TEXT NULL, \"publisher\" TEXT NULL, \"published_year\" INTEGER NULL, \"page_count\" INTEGER NULL, \"cover_path\" TEXT NULL, \"spine_style\" TEXT NULL, \"reading_progress\" REAL NULL, \"last_read_page\" INTEGER NULL, \"last_read_at\" INTEGER NULL, \"reader_notes\" TEXT NULL, \"source_metadata\" TEXT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"needs_push\" INTEGER NOT NULL DEFAULT 1 CHECK (\"needs_push\" IN (0, 1)), \"cover_etag\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "authors",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"authors\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL UNIQUE, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "book_authors",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"book_authors\" (\"book_id\" TEXT NOT NULL REFERENCES books (id), \"author_id\" TEXT NOT NULL REFERENCES authors (id), \"position\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"book_id\", \"author_id\"));"
        }
      ]
    },
    {
      "name": "genres",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"genres\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL UNIQUE, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "book_genres",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"book_genres\" (\"book_id\" TEXT NOT NULL REFERENCES books (id), \"genre_id\" TEXT NOT NULL REFERENCES genres (id), PRIMARY KEY (\"book_id\", \"genre_id\"));"
        }
      ]
    },
    {
      "name": "book_files",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"book_files\" (\"id\" TEXT NOT NULL, \"book_id\" TEXT NOT NULL REFERENCES books (id), \"format\" TEXT NOT NULL, \"path\" TEXT NOT NULL, \"size_bytes\" INTEGER NOT NULL, \"sha256\" TEXT NOT NULL, \"added_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "physical_copies",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"physical_copies\" (\"id\" TEXT NOT NULL, \"book_id\" TEXT NOT NULL REFERENCES books (id), \"location\" TEXT NULL, \"condition\" TEXT NULL, \"notes\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "loans",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"loans\" (\"id\" TEXT NOT NULL, \"copy_id\" TEXT NOT NULL REFERENCES physical_copies (id), \"borrower\" TEXT NOT NULL, \"loaned_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"returned_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "shelves",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"shelves\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"needs_push\" INTEGER NOT NULL DEFAULT 1 CHECK (\"needs_push\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "shelf_books",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"shelf_books\" (\"shelf_id\" TEXT NOT NULL REFERENCES shelves (id), \"book_id\" TEXT NOT NULL REFERENCES books (id), \"position\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"shelf_id\", \"book_id\"));"
        }
      ]
    },
    {
      "name": "physical_environments",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"physical_environments\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "physical_shelves",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"physical_shelves\" (\"id\" TEXT NOT NULL, \"environment_id\" TEXT NOT NULL REFERENCES physical_environments (id), \"x1\" REAL NOT NULL, \"y1\" REAL NOT NULL, \"x2\" REAL NOT NULL, \"y2\" REAL NOT NULL, \"label\" TEXT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "book_placements",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"book_placements\" (\"id\" TEXT NOT NULL, \"environment_id\" TEXT NOT NULL REFERENCES physical_environments (id), \"copy_id\" TEXT NOT NULL REFERENCES physical_copies (id), \"x\" REAL NOT NULL, \"y\" REAL NOT NULL, \"rotation\" INTEGER NOT NULL DEFAULT 0, \"width_override\" REAL NULL, \"height_override\" REAL NULL, \"format\" TEXT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "local_deletions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_deletions\" (\"book_id\" TEXT NOT NULL, \"deleted_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"kind\" TEXT NOT NULL DEFAULT 'book', PRIMARY KEY (\"book_id\"));"
        }
