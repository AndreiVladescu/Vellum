# Rust (server/)
server/target/

# Local databases
*.db
*.db-shm
*.db-wal

# Server blob store (created at runtime)
server/data/

# TLS material. `VELLUM_TLS=1` generates a self-signed pair beside the binary;
# a private key was committed once and had to be filtered back out of history.
*.pem

# Local environment files. The server is configured entirely by environment, so
# the obvious way to run it is a file holding VELLUM_SMTP_PASS — which is a real
# credential and must never be a commit away from being published.
.env
.env.*
!.env.example

# Build artefacts. Releases carry these (see .github/workflows/release.yml);
# the repository should not — a 17 MB tarball was tracked, and every clone paid
# for it forever.
app/dist/
app/build/

# Editor/OS noise
.vscode/
.idea/
*.swp
.DS_Store

# Local packaging staging (linux/packaging/*.sh)
app/vellum-[0-9]*/

# Local secrets: signing keystores, passwords, anything that must never
# reach GitHub. Ignored, and CI fails if a file under it is ever tracked.
.vault/
